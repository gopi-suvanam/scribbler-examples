    {
      "code": "  await scrib.loadScript(\"https://websd.mlc.ai/dist/tvmjs_runtime.wasi.js\");\n  await scrib.loadScript(\"https://examples.scribbler.live/AI-DataScience/tvmjs-modified.bundle.js\");\n  await scrib.loadScript(\"https://examples.scribbler.live/stable_diffusion.js\");\n  await scrib.loadScript(\"https://websd.mlc.ai/assets/js/srcset-polyfill.js\");\n\n\n async function loadSDEngine(){\n     tvmjsGlobalEnv={};\n\n  const canvas = document.querySelector(\"canvas\"); // 👈 adjust if needed\n\n   \n  tokenizers=await import( \"https://websd.mlc.ai/dist/tokenizers-wasm/tokenizers_wasm.js\");\n  TokenizerWasm = tokenizers.TokenizerWasm;\n  init=tokenizers.default;\n  async function getTokenizer(name) {\n\tawait init();\n\tconst jsonText = await (await fetch(\"https://huggingface.co/\" + name + \"/raw/main/tokenizer.json\")).text();\n\treturn new TokenizerWasm(jsonText);\n  }\n  tvmjsGlobalEnv.getTokenizer = getTokenizer;  \n  function initProgressCallback(report) {\n\tdocument.getElementById(\"init-progress-tracker-label\").innerHTML = report.text;\n\tdocument.getElementById(\"init-progress-tracker-progress\").value = report.progress * 100;\n  }\n  window.sdEngine=await getWebStableDiffusion(initProgressCallback,scrib.getDom(\"canvas\"));\n   \n         \n}\nawait loadSDEngine();\ndocument.getElementById(\"init-progress-tracker-label\").innerHTML = \"Model ready to be used\";",
      "status": "[1]<br><span style=\"font-size:8px\">18.611s<span></span></span>",
      "output": "",
      "type": "code"
    },
    {
      "code": "function progressCallback(stage, counter, numSteps, totalNumSteps) {\n  console.log(stage, counter, numSteps, totalNumSteps);\n  return;\n}",
      "status": "[2]<br><span style=\"font-size:8px\">0ms<span></span></span>",
