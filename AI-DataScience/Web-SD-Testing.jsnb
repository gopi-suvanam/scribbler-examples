      "code": "\n\nasync function generate() {\n  const prompts = [\n    \"A futuristic city floating above the clouds at sunset, neon lights glowing, ultra-detailed, cinematic lighting\",\n   \"A majestic lion made of fire and smoke standing in a dark forest, dramatic atmosphere, high contrast\",\n    \"A cozy reading nook inside a treehouse during rain, warm lighting, books and plants everywhere\",\n    \"An astronaut relaxing on Mars with a picnic setup, Earth visible in the sky, surreal and whimsical\",\n    \"A cyberpunk street market at night with glowing signs, rain reflections, and diverse characters\",\n    \"A dragon flying over a medieval castle during a thunderstorm, epic fantasy art style\",\n    \"A tiny cottage inside a giant mushroom in an enchanted forest, soft magical glow, fairytale vibe\",\n    \"A hyper-realistic portrait of an elderly woman with galaxy textures in her skin, cosmic theme\",\n    \"A futuristic robot painting a landscape on a canvas in a minimalist studio, soft lighting\",\n    \"An underwater city with mermaids and glowing coral structures, bioluminescent colors, fantasy style\"\n  ];\n\n const zip = new JSZip();\n  const timings = [];\n\n  const canvas = document.querySelector(\"canvas\"); // 👈 adjust if needed\n\t\n  const sizes=[256,512,1024];\n  \n  \n\t//canvas.width=1024;canvas.height=1024;\n  for(let j=0;j<sizes.length;j++){\n\tcanvas.height=sizes[j];canvas.width=sizes[j];\n\t  for (let i = 0; i < prompts.length; i++) {\n\t\t\n\t\tconst prompt = prompts[i];\n\t\tconst start = Date.now();\n\n\t\t await sdEngine.generate(\n\t\t  prompt,\n\t\t  \"nudity\",\n\t\t  progressCallback,\n\t\t  0,\n\t\t  2,2\n\t\t);\n\n\n\n\t\t  // Now you have pixel data → draw to 2D canvas\n\n\n\t\tconst end = Date.now();\n\t\ttimings.push({size:j+1,prompt:i+1,timing:(end - start) / 1000});\n\n\n\n\t\tscrib.show((['sm','md','lg'])[j],\"|\",prompt, \"|\", (end - start) / 1000,\"|\", \"seconds\");\n\n\t  }\n  }\n  console.log(timings);\n  window.timings=timings;\n}\ngenerate()",
