      "code": "await scrib.loadScript(\"https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js\");",
      "status": "[3]<br><span style=\"font-size:8px\">2ms<span></span></span>",
      "output": "",
