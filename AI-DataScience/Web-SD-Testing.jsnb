    {
      "code": "\n\nasync function generate() {\n  \n  const prompts = [\n   \"A futuristic city floating above the clouds at sunset, neon lights glowing, ultra-detailed, cinematic lighting\",\n   \"A majestic lion made of fire and smoke standing in a dark forest, dramatic atmosphere, high contrast\",\n    \"A cozy reading nook inside a treehouse during rain, warm lighting, books and plants everywhere\",\n    \"An astronaut relaxing on Mars with a picnic setup, Earth visible in the sky, surreal and whimsical\",\n    \"A cyberpunk street market at night with glowing signs, rain reflections, and diverse characters\",\n    \"A dragon flying over a medieval castle during a thunderstorm, epic fantasy art style\",\n    \"A tiny cottage inside a giant mushroom in an enchanted forest, soft magical glow, fairytale vibe\",\n    \"A hyper-realistic portrait of an elderly woman with galaxy textures in her skin, cosmic theme\",\n    \"A futuristic robot painting a landscape on a canvas in a minimalist studio, soft lighting\",\n    \"An underwater city with mermaids and glowing coral structures, bioluminescent colors, fantasy style\"\n  ];\n\n const zip = new JSZip();\n  const timings = [];\n\n  const canvas = document.querySelector(\"canvas\"); // 👈 adjust if needed\n\t\n  const sizes=[256,512,1024];\n  \n  \n\t//canvas.width=1024;canvas.height=1024;\n  \n  for(let schedulerId=0;schedulerId<=1;schedulerId++){\n\tfor(let j=0;j<sizes.length;j++){\n\t\tfor (let i = 0; i < prompts.length; i++) {\n\t\t  console.log(schedulerId);\n\n\t\t  const prompt = prompts[i];\n\t\t  const start = Date.now();\n\t\t\tcanvas.height=sizes[j];canvas.width=sizes[j];\n\t\t   await sdEngine.generate(\n\t\t\tprompt,\n\t\t\t\"nsfw, nude, naked, explicit, sexual content\",\n\t\t\tprogressCallback,\n\t\t\tschedulerId,\n\t\t\t10,10,100,64,64\n\t\t  );\n\n\n\n\t\t\t// Now you have pixel data → draw to 2D canvas\n\n\n\t\t  const end = Date.now();\n\t\t  timings.push({steps:([20,50])[schedulerId],size:j+1,prompt:i+1,timing:(end - start) / 1000});\n\n\n\n\t\t  scrib.show(([20,50])[schedulerId],\" steps\",\"|\",(['sm','md','lg'])[j],\"|\",prompt, \"|\", (end - start) / 1000,\"|\", \"seconds\");\n\n\t\t}\n\t}\n  }\n  console.log(timings);\n  window.timings=timings;\n}\ngenerate()",
